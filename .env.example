# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Bedrock Model Configuration
# Use us.amazon.nova-lite-v1:0 for Amazon Nova Lite
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Reddit API Configuration (for scraping World Cup discussions)
# Get credentials at: https://www.reddit.com/prefs/apps
# Create a "script" app to get client_id and client_secret
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Optional: Geocoding API (currently using Nominatim, free tier)
# You can add Google Maps API key if needed for better geocoding
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
